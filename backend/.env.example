# Base de dados MySQL
DB_HOST=localhost
DB_USER=aidam_user
DB_PASS=
DB_NAME=aidam_cms
DB_PORT=3306

# Autenticação
JWT_SECRET=alterar-para-uma-cadeia-longa-e-aleatoria
JWT_EXPIRA=12h

# SMTP (Nodemailer)
SMTP_HOST=mail.aidam.co.mz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=geral@aidam.co.mz
SMTP_PASS=
EMAIL_DESTINO=geral@aidam.co.mz
EMAIL_REMETENTE="Website AIDAM <geral@aidam.co.mz>"

# CORS — domínios autorizados (separados por vírgula)
CORS_ORIGEM=https://aidam.co.mz,https://www.aidam.co.mz

# Porta (o cPanel define automaticamente)
PORT=3000

# URL pública da API (usada para gerar os endereços dos ficheiros carregados)
URL_PUBLICA=https://api.aidam.co.mz
